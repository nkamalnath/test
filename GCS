using System;
using System.IO;
using System.Threading.Tasks;
using Google.Cloud.Storage.V1;

public class GcsDownloader
{
    private readonly StorageClient _storageClient = StorageClient.Create();

    public async Task DownloadActiveVersionFilesAsync(string bucketName, string localDownloadRootDir)
    {
        string relevantPrefix = "deployments/"; 

        // 1. (Same as before) Find the active version folder path
        var listOptions = new ListObjectsOptions
        {
            Delimiter = "/",
            Fields = "prefixes,nextPageToken"
        };

        var response = _storageClient.ListObjectsAsync(bucketName, relevantPrefix, listOptions);
        var versionFolders = new List<string>();
        await foreach (var page in response.AsRawResponses())
        {
            if (page.Prefixes != null)
            {
                versionFolders.AddRange(page.Prefixes);
            }
        }

        string activePath = GetLatestVersionPath(versionFolders);
        if (string.IsNullOrEmpty(activePath))
        {
            Console.WriteLine("No active version found to download.");
            return;
        }

        Console.WriteLine($"Downloading files from active path: '{activePath}'");

        // 2. Fetch the metadata list of all files inside that active path
        var fileOptions = new ListObjectsOptions
        {
            Fields = "items(name),nextPageToken"
        };

        var files = _storageClient.ListObjectsAsync(bucketName, activePath, fileOptions);

        // 3. Loop through and download each file
        await foreach (var file in files)
        {
            // Skip directory placeholders
            if (file.Name == activePath || file.Name.EndsWith("/")) continue;

            // Determine where the file should live locally
            // e.g., converts "deployments/v12/subfolder/app.dll" to "subfolder/app.dll"
            string relativePath = file.Name.Substring(activePath.Length);
            string localFilePath = Path.Combine(localDownloadRootDir, relativePath);

            // Ensure the local folder structure exists
            string? localFileDir = Path.GetDirectoryName(localFilePath);
            if (!string.IsNullOrEmpty(localFileDir))
            {
                Directory.CreateDirectory(localFileDir);
            }

            Console.WriteLine($"Downloading: {file.Name} -> {localFilePath}");

            // 4. Download the file asynchronously
            using (var localFileStream = File.OpenWrite(localFilePath))
            {
                await _storageClient.DownloadObjectAsync(
                    bucketName, 
                    file.Name, 
                    localFileStream
                );
            }
        }

        Console.WriteLine("Download complete!");
    }

    private string GetLatestVersionPath(IEnumerable<string> paths)
    {
        var versionRegex = new System.Text.RegularExpressions.Regex(@"deployments/v(\d+)/$", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return paths
            .Select(p => new { Path = p, Match = versionRegex.Match(p) })
            .Where(x => x.Match.Success)
            .Select(x => new { x.Path, VersionNumber = int.Parse(x.Match.Groups[1].Value) })
            .OrderByDescending(x => x.VersionNumber)
            .Select(x => x.Path)
            .FirstOrDefault();
    }
}
