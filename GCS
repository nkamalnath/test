using Google.Cloud.Storage.V1;
using Google.Apis.Storage.v1.Data;
using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Threading.Tasks;

public class GcsVersionFetcher
{
    public static async Task<string> GetLatestVersionFolderAsync(
        StorageClient storageClient, string bucketName, string parentPrefix = "")
    {
        var options = new ListObjectsOptions { Delimiter = "/" };

        var pages = storageClient
            .ListObjects(bucketName, parentPrefix, options)
            .AsRawResponses();

        var versionFolders = new List<(int Version, string Prefix)>();

        foreach (Objects page in pages)
        {
            if (page.Prefixes == null) continue;

            foreach (var prefix in page.Prefixes)
            {
                // prefix looks like "releases/v12/"
                var name = prefix.TrimEnd('/').Split('/')[^1]; // "v12"
                if (name.StartsWith("v") && int.TryParse(name[1..], out int num))
                {
                    versionFolders.Add((num, prefix));
                }
            }
        }

        if (versionFolders.Count == 0)
            throw new InvalidOperationException($"No version folders found under '{parentPrefix}'");

        var latest = versionFolders.OrderByDescending(v => v.Version).First();
        return latest.Prefix; // e.g. "releases/v12/"
    }

    public static async Task<List<Google.Apis.Storage.v1.Data.Object>> GetFilesInFolderAsync(
        StorageClient storageClient, string bucketName, string folderPrefix)
    {
        var files = new List<Google.Apis.Storage.v1.Data.Object>();

        await foreach (var obj in storageClient.ListObjectsAsync(bucketName, folderPrefix))
        {
            // Skip the "folder placeholder" object itself, if one exists
            if (obj.Name == folderPrefix) continue;
            files.Add(obj);
        }

        return files;
    }

    public static async Task DownloadFolderAsync(
        StorageClient storageClient, string bucketName, string folderPrefix, string localDir)
    {
        Directory.CreateDirectory(localDir);

        var files = await GetFilesInFolderAsync(storageClient, bucketName, folderPrefix);

        foreach (var file in files)
        {
            var relativeName = file.Name[folderPrefix.Length..]; // strip the prefix
            var localPath = Path.Combine(localDir, relativeName);

            Directory.CreateDirectory(Path.GetDirectoryName(localPath)!);

            using var stream = File.OpenWrite(localPath);
            await storageClient.DownloadObjectAsync(bucketName, file.Name, stream);

            Console.WriteLine($"Downloaded {file.Name} -> {localPath}");
        }
    }

    public static async Task RunAsync(string bucketName, string parentPrefix, string localDir)
    {
        var storageClient = await StorageClient.CreateAsync();

        var latestFolder = await GetLatestVersionFolderAsync(storageClient, bucketName, parentPrefix);
        Console.WriteLine($"Latest version folder: {latestFolder}");

        await DownloadFolderAsync(storageClient, bucketName, latestFolder, localDir);
    }
}
